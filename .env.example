# Service account: JSON (raw or base64) OR only the PEM private key ("-----BEGIN PRIVATE KEY-----...", multi-line or with \n)
# In the PEM case also set the email:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Workspace user to impersonate (domain-wide delegation). Needed to see resource calendars and to book rooms.
GOOGLE_IMPERSONATE_USER=

# All calendars (and resource calendars) are read from this user's calendar list.
