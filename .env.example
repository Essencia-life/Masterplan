# Service account: JSON (raw or base64) OR only the PEM private key ("-----BEGIN PRIVATE KEY-----...", multi-line or with \n)
# In the PEM case also set the email:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Workspace user to impersonate (domain-wide delegation). Needed to see resource calendars and to book rooms.
GOOGLE_IMPERSONATE_USER=

# All calendars (and resource calendars) are read from this user's calendar list.

# Login (OAuth, Workspace users only) – write access follows each user's Google calendar permissions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI to register: <origin>/auth/callback
ALLOWED_DOMAIN=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Cache (optional, falls back to in-process memory). Upstash Redis REST credentials,
# or KV_REST_API_URL / KV_REST_API_TOKEN when added through the Vercel marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
